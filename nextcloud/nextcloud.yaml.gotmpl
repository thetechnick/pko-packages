apiVersion: v1
kind: Service
metadata:
  name: nextcloud-headless
  labels:
    app: nextcloud
  annotations:
    package-operator.run/phase: deploy
spec:
  ports:
  - name: https
    port: 443
    targetPort: 8443
  selector:
    app: nextcloud
  type: ClusterIP
  clusterIP: None
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: nextcloud
  labels:
    app: nextcloud
  annotations:
    package-operator.run/phase: deploy
spec:
  replicas: 1
  selector:
    matchLabels:
      app: nextcloud
  serviceName: nextcloud-headless
  template:
    metadata:
      labels:
        app: nextcloud
    spec:
      containers:
      - name: nextcloud
        image: "{{.images.nextcloud}}"
        volumeMounts:
        - mountPath: /var/www/html
          name: webroot
        - mountPath: /var/www/html/data
          name: data
        env:
        - name: REDIS_HOST
          value: localhost
        - name: POSTGRES_HOST
          value: {{ .config.databaseHost }}
        - name: POSTGRES_DB
          value: {{ .config.databaseName }}
        - name: POSTGRES_USER
          valueFrom:
            secretKeyRef:
              name: {{ .config.databaseSecretName }}
              key: username
        - name: POSTGRES_PASSWORD
          valueFrom:
            secretKeyRef:
              name: {{ .config.databaseSecretName }}
              key: password
        ports:
        - name: http
          containerPort: 80
      - command:
        - /cron.sh
        env:
        - name: REDIS_HOST
          value: localhost
        - name: POSTGRES_HOST
          value: {{ .config.databaseHost }}
        - name: POSTGRES_DB
          value: {{ .config.databaseName }}
        - name: POSTGRES_USER
          valueFrom:
            secretKeyRef:
              name: {{ .config.databaseSecretName }}
              key: username
        - name: POSTGRES_PASSWORD
          valueFrom:
            secretKeyRef:
              name: {{ .config.databaseSecretName }}
              key: password
        image: "{{.images.nextcloud}}"
        name: cron
        volumeMounts:
        - mountPath: /var/www/html
          name: webroot
        - mountPath: /var/www/html/data
          name: data
      - name: redis
        args:
        - redis-server
        - --save ''
        - --appendonly no
        - --maxmemory 483183820800
        - --maxmemory-policy allkeys-lfu
        image: "{{.images.redis}}"
{{- if hasKey .config.storage "hostDir" }}
      volumes:
      - hostPath:
          path: /mnt/k8s/apps/nextcloud-data
          type: Directory
        name: data
      - hostPath:
          path: /mnt/k8s/apps/nextcloud-webroot
          type: Directory
        name: webroot
{{- end}}
{{- if hasKey .config.storage "pvc" }}
  volumeClaimTemplates:
  - metadata:
      name: data
    spec:
      accessModes: [ "ReadWriteOnce" ]
      storageClassName: {{.config.storage.pvc.storageClassName}}
      resources:
        requests:
          storage: {{.config.storage.pvc.dataStorage}}
  - metadata:
      name: webroot
    spec:
      accessModes: [ "ReadWriteOnce" ]
      storageClassName: {{.config.storage.pvc.storageClassName}}
      resources:
        requests:
          storage: 5Gi
{{- end}}